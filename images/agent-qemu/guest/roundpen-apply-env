#!/bin/bash
# Copy QEMU fw_cfg env into the guest and point Claude Code at llmgw.
set -euo pipefail

DEST=/etc/roundpen/env
FW=/sys/firmware/qemu_fw_cfg/by_name/opt/roundpen/env/raw
mkdir -p /etc/roundpen /etc/claude-code /etc/profile.d /home/roundpen/.claude
modprobe qemu_fw_cfg 2>/dev/null || true
for _ in 1 2 3 4 5; do
  [[ -r "$FW" ]] && break
  sleep 0.2
done

if [[ -r "$FW" ]]; then
  cp "$FW" "$DEST"
elif [[ ! -s "$DEST" ]]; then
  cat > "$DEST" <<'EOF'
ROUNDPEN_URL=http://10.0.2.2:9527
ANTHROPIC_BASE_URL=http://10.0.2.2:9527/llmgw/anthropic
OPENAI_BASE_URL=http://10.0.2.2:9527/llmgw/openai
ANTHROPIC_API_KEY=vk-roundpen-internal
ANTHROPIC_AUTH_TOKEN=vk-roundpen-internal
OPENAI_API_KEY=vk-roundpen-internal
ACP_PERMISSION_MODE=bypassPermissions
EOF
fi
chmod 0644 "$DEST"

{
  echo "# generated by roundpen-apply-env — do not edit"
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    key="${line%%=*}"
    case "$key" in
      [A-Za-z_]*) printf 'export %s\n' "$line" ;;
    esac
  done < "$DEST"
} > /etc/profile.d/roundpen-llmgw.sh
chmod 0644 /etc/profile.d/roundpen-llmgw.sh

# pam_env + non-interactive SSH (`ssh host claude`) need /etc/environment.
{
  echo "# generated by roundpen-apply-env — do not edit"
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ''|\#*) continue ;;
    esac
    key="${line%%=*}"
    case "$key" in
      [A-Za-z_]*) printf '%s\n' "$line" ;;
    esac
  done < "$DEST"
} > /etc/environment

if [[ ! -f /home/roundpen/.bashrc ]] || ! grep -q 'roundpen/env' /home/roundpen/.bashrc 2>/dev/null; then
  cat >> /home/roundpen/.bashrc <<'EOF'

# Roundpen llmgw (also applied via /etc/environment and managed-settings.json)
if [ -f /etc/roundpen/env ]; then
  set -a
  # shellcheck disable=SC1091
  . /etc/roundpen/env
  set +a
fi
EOF
fi

python3 - "$DEST" <<'PY'
import json, os, sys
env = {}
with open(sys.argv[1], encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        env[k] = v
anth_key = env.get("ANTHROPIC_API_KEY") or env.get("ANTHROPIC_AUTH_TOKEN") or ""
settings = {
    "env": {
        "ANTHROPIC_BASE_URL": env.get("ANTHROPIC_BASE_URL", ""),
        "ANTHROPIC_API_KEY": anth_key,
        "ANTHROPIC_AUTH_TOKEN": env.get("ANTHROPIC_AUTH_TOKEN") or anth_key,
        "OPENAI_BASE_URL": env.get("OPENAI_BASE_URL", ""),
        "OPENAI_API_KEY": env.get("OPENAI_API_KEY", ""),
        "ACP_PERMISSION_MODE": env.get("ACP_PERMISSION_MODE", "bypassPermissions"),
    }
}
for path in ("/etc/claude-code/managed-settings.json", "/home/roundpen/.claude/settings.json"):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as out:
        json.dump(settings, out, indent=2)
        out.write("\n")
PY
chown -R roundpen:roundpen /home/roundpen/.claude /home/roundpen/.bashrc
mkdir -p /home/roundpen/.roundpen
cp "$DEST" /home/roundpen/.roundpen/env
chown -R roundpen:roundpen /home/roundpen/.roundpen
