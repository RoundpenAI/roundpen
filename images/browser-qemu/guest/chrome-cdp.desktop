[Desktop Entry]
Type=Application
Name=Chrome CDP
Exec=/usr/bin/google-chrome-stable --no-first-run --no-default-browser-check --disable-gpu --disable-dev-shm-usage --remote-debugging-address=0.0.0.0 --remote-debugging-port=9222 about:blank
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-enabled=true
