# Example environment for roundpend (copy to .env and fill in).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/roundpen?sslmode=disable
ROUNDPEN_HTTP_ADDR=:9527
ROUNDPEN_BACKEND=kern
ROUNDPEN_DEFAULT_IMAGE=host
ROUNDPEN_DATA_ROOT=./data
# ROUNDPEN_API_KEY=dev-secret

# LLM gateway (model-relay style; vault + logs in PostgreSQL)
# ROUNDPEN_LLMGW_ENABLED=true
# ROUNDPEN_LLMGW_OPENAI_BASE_URL=https://api.openai.com
# ROUNDPEN_LLMGW_OPENAI_API_KEY=sk-...
# ROUNDPEN_LLMGW_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ROUNDPEN_LLMGW_ANTHROPIC_API_KEY=sk-ant-...
# ROUNDPEN_LLMGW_VIRTUAL_KEYS=vk-dev:dev,vk-prod:prod
# ROUNDPEN_LLMGW_EMBEDDING_MODEL=text-embedding-3-small
# ROUNDPEN_LLMGW_LOG_BODY_MAX_BYTES=65536
# ROUNDPEN_LLMGW_PUBLIC_URL=http://localhost:9527
# Internal vkey vk-roundpen-internal + alias roundpen-embed are auto-seeded for memory embeddings.

# Docker on remote host (workspace lives on that host; control plane uses SSH FS):
# ROUNDPEN_BACKEND=docker
# DOCKER_HOST=ssh://mike@10.10.1.5
# ROUNDPEN_DATA_ROOT=/var/lib/roundpen
# ROUNDPEN_DEFAULT_IMAGE=alpine:3.20
# ROUNDPEN_DOCKER_RUNTIME=runc
