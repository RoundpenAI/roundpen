# Example environment for roundpend (copy to .env and fill in).
# `make dev` copies this file and may bump ROUNDPEN_HTTP_ADDR to :19001 for Vite.
DATABASE_URL=postgres://roundpen:roundpen@127.0.0.1:5432/roundpen?sslmode=disable
# Separate DB for go test — keeps dev template registry clean (see internal/template/testutil_test.go).
ROUNDPEN_TEST_DATABASE_URL=postgres://roundpen:roundpen@127.0.0.1:5432/roundpen_test?sslmode=disable
ROUNDPEN_HTTP_ADDR=:9527
ROUNDPEN_BACKEND=docker
# Agent is Docker-only. Default image is the official OCI artifact; override for a
# private mirror or local build. Policy: pin a semver tag in production, use :latest for dev.
ROUNDPEN_DEFAULT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
ROUNDPEN_AGENT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
ROUNDPEN_DEFAULT_AGENT_TEMPLATE=code-agent
ROUNDPEN_DATA_ROOT=./data
ROUNDPEN_BOOTSTRAP_ADMIN=true
# ROUNDPEN_API_KEY=rp-dev-secret
# ROUNDPEN_ALLOW_PUBLIC_REGISTRATION=false

# Web tools: WebSearch (Tavily-compatible). Prefer Settings → Web tools in the UI;
# these vars only seed the first boot and the settings row overrides them.
# Loopback endpoints (127.0.0.1) are rejected by the outbound dial guard.
# ROUNDPEN_WEB_SEARCH_ENDPOINT=https://api.tavily.com
# ROUNDPEN_WEB_SEARCH_API_KEY=tvly-...

# Browser source (also editable in Admin → Settings). auto | docker | remote | cloud | host
# auto resolves to docker: one Roundpen-managed browserless/chrome container per user,
# dialed over the container network on ROUNDPEN_CDP_PORT (no published ports).
# ROUNDPEN_CDP_PROVIDER=auto
# ROUNDPEN_CDP_PORT=3000
# remote / cloud: a LAN or commercial browserless endpoint (+ optional token)
# ROUNDPEN_CDP_ENDPOINT=http://127.0.0.1:3000
# ROUNDPEN_CDP_TOKEN=

# Browser image (OCI ref, pulled on first use) and template name.
# ROUNDPEN_BROWSER_IMAGE=ghcr.io/browserless/chrome:v2.56.7
# ROUNDPEN_DEFAULT_BROWSER_TEMPLATE=browser
# Playwright driver for the browser engine: auto-installed on first use, or pre-install
# with `make browser-driver`. Tune for image builds / intranet mirrors:
# PLAYWRIGHT_DRIVER_PATH=
# PLAYWRIGHT_NODEJS_PATH=
# PLAYWRIGHT_GO_NPM_REGISTRY=

# Desktop / Mobile slots (reserved; QEMU)
# ROUNDPEN_QEMU_ENABLED=true
# ROUNDPEN_QEMU_BIN=qemu-system-x86_64
# Git access is per-user (Settings → Git). Tokens live in PostgreSQL and are
# installed inside the Agent container via exec (not by writing the host directory).
# Agent OCI image: pulled from the registry on first start, or loaded offline:
#   docker load -i code-agent.tar
# Local developer override: ROUNDPEN_AGENT_IMAGE=roundpen-code-agent:local

# Preview (path-based /p/{sandbox}/{port}/ with short-lived token)
ROUNDPEN_PREVIEW_PUBLIC_URL=http://127.0.0.1:9527
# ROUNDPEN_PREVIEW_TOKEN_TTL=900

# LLM gateway (model-relay style; vault + logs in PostgreSQL)
# ROUNDPEN_LLMGW_ENABLED=true
# ROUNDPEN_LLMGW_OPENAI_BASE_URL=https://api.openai.com
# ROUNDPEN_LLMGW_OPENAI_API_KEY=sk-...
# ROUNDPEN_LLMGW_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ROUNDPEN_LLMGW_ANTHROPIC_API_KEY=sk-ant-...
# ROUNDPEN_LLMGW_VIRTUAL_KEYS=vk-dev:dev,vk-prod:prod
# ROUNDPEN_LLMGW_EMBEDDING_MODEL=text-embedding-3-small
# Fallback when request model is not in upstream model map (applies to openai + anthropic relays)
# ROUNDPEN_LLMGW_DEFAULT_MODEL=gpt-4o-mini
# ROUNDPEN_LLMGW_LOG_BODY_MAX_BYTES=65536
# ROUNDPEN_LLMGW_PUBLIC_URL=http://localhost:9527
# Internal vkey vk-roundpen-internal + alias roundpen-embed are auto-seeded for memory embeddings.

# Template builds (optional). Empty/disabled = no local builds; set docker|ci in Settings.
# ROUNDPEN_TEMPLATE_BUILDER=
# Docker + Kata (local). Requires Docker Engine with kata/kata-fc runtimes
# registered in /etc/docker/daemon.json (see scripts or host setup).
# ROUNDPEN_BACKEND=docker
# DOCKER_HOST=unix:///var/run/docker.sock
# ROUNDPEN_DEFAULT_IMAGE=alpine:3.20
# ROUNDPEN_DOCKER_RUNTIME=kata
# ROUNDPEN_DOCKER_RUNTIME=kata-fc
#
# Docker on remote host (workspace lives on that host; control plane uses SSH FS):
# ROUNDPEN_BACKEND=docker
# DOCKER_HOST=ssh://mike@10.10.1.5
# ROUNDPEN_DATA_ROOT=/var/lib/roundpen
# ROUNDPEN_DEFAULT_IMAGE=alpine:3.20
# ROUNDPEN_DOCKER_RUNTIME=runc
