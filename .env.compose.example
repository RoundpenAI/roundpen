# Copy to repo-root `.env` for docker compose (optional overrides).
POSTGRES_PASSWORD=roundpen
# Postgres is not published on the host by default (see compose.yaml).
# POSTGRES_PORT=5432
ROUNDPEN_PORT=9527
# Agent is Docker-only. The control-plane container needs access to a Docker
# daemon (mount /var/run/docker.sock — see compose.yaml).
ROUNDPEN_BACKEND=docker
ROUNDPEN_AGENT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
ROUNDPEN_DEFAULT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
ROUNDPEN_PREVIEW_PUBLIC_URL=http://127.0.0.1:9527
# ROUNDPEN_API_KEY=rp-change-me
