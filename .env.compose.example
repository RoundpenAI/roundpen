# Copy to repo-root `.env` for docker compose.
#
# POSTGRES_PASSWORD is REQUIRED — compose refuses to start until it is set, so
# no deploy ships a shared default. Generate a strong one, e.g.:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# POSTGRES_PASSWORD=
# Postgres is not published on the host by default (see compose.yaml).
# POSTGRES_PORT=5432
ROUNDPEN_PORT=9527
# Agent and Browser are Docker-only. The control-plane container needs access to
# a Docker daemon (mount /var/run/docker.sock — see compose.yaml) and pulls the
# per-user browserless/chrome container for the Browser slot.
ROUNDPEN_BACKEND=docker
ROUNDPEN_AGENT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
ROUNDPEN_DEFAULT_IMAGE=ghcr.io/roundpenai/code-agent:0.1.0
# ROUNDPEN_BROWSER_IMAGE=ghcr.io/browserless/chrome:v2.56.7
# Browser source: auto | docker | remote | cloud | host (see .env.example)
ROUNDPEN_PREVIEW_PUBLIC_URL=http://127.0.0.1:9527
# Optional: wildcard zone for per-port preview origins ({sandbox}-{port}.rp.mk).
# Needs DNS + TLS covering one label of that zone; see .env.example.
# ROUNDPEN_PREVIEW_DOMAIN=rp.mk
# ROUNDPEN_API_KEY=rp-change-me
