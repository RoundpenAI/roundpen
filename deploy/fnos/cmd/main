#!/bin/bash
# Start / stop / status for the host-side roundpend process.
# Postgres is managed by the bundled pg0 (started before roundpend).

set -u

BIN_DIR="${TRIM_APPDEST}/bin"
ROUNDPEND="${BIN_DIR}/roundpend"
ENSURE_PG0="${BIN_DIR}/ensure-pg0.sh"
ENVFILE="${TRIM_PKGVAR}/roundpend.env"
PIDFILE="${TRIM_PKGVAR}/roundpend.pid"
LOGFILE="${TRIM_PKGVAR}/roundpend.log"
PORT="${TRIM_SERVICE_PORT:-9527}"

load_env() {
    if [ -f "${ENVFILE}" ]; then
        set -a
        # shellcheck disable=SC1090
        . "${ENVFILE}"
        set +a
    fi
}

is_running() {
    if [ -f "${PIDFILE}" ]; then
        pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

do_start() {
    if is_running; then
        exit 0
    fi
    mkdir -p "${TRIM_PKGVAR}/data" "${TRIM_PKGVAR}/.pg0" || exit 1
    if [ ! -x "${ROUNDPEND}" ]; then
        echo "roundpend binary missing: ${ROUNDPEND}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi
    if [ ! -x "${ENSURE_PG0}" ]; then
        echo "ensure-pg0.sh missing: ${ENSURE_PG0}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi

    load_env
    # Same HOME/PG0 layout as install_callback (package hooks often lack HOME).
    export HOME="${TRIM_PKGVAR}"
    export PG0_HOME="${TRIM_PKGVAR}/.pg0"
    export PG0_DATA_DIR="${PG0_HOME}/instances/roundpen/data"
    export PG0_PORT="${PG0_PORT:-15432}"
    export PG0_NAME="${PG0_NAME:-roundpen}"
    if [ -z "${DATABASE_URL:-}" ]; then
        export DATABASE_URL="postgres://roundpen:roundpen@127.0.0.1:${PG0_PORT}/roundpen?sslmode=disable"
    fi
    export ROUNDPEN_PG0_BIN="${BIN_DIR}/pg0"
    export ROUNDPEN_ENSURE_PG0_ENV_FILE="${ENVFILE}"
    export ROUNDPEN_DATA_ROOT="${TRIM_PKGVAR}/data"
    export ROUNDPEN_HTTP_ADDR=":${PORT}"
    export ROUNDPEN_BACKEND="${ROUNDPEN_BACKEND:-docker}"
    export ROUNDPEN_BOOTSTRAP_ADMIN="${ROUNDPEN_BOOTSTRAP_ADMIN:-true}"
    export ROUNDPEN_BOOTSTRAP_ADMIN_PASSWORD="${ROUNDPEN_BOOTSTRAP_ADMIN_PASSWORD:-RoundpenAdmin1}"
    export ROUNDPEN_IM_ENABLED="${ROUNDPEN_IM_ENABLED:-true}"
    export ROUNDPEN_AGENT_IMAGE="${ROUNDPEN_AGENT_IMAGE:-ghcr.io/roundpenai/code-agent:0.1.0}"
    export ROUNDPEN_DEFAULT_IMAGE="${ROUNDPEN_DEFAULT_IMAGE:-ghcr.io/roundpenai/code-agent:0.1.0}"
    if [ -z "${ROUNDPEN_PREVIEW_PUBLIC_URL:-}" ]; then
        export ROUNDPEN_PREVIEW_PUBLIC_URL="http://127.0.0.1:${PORT}"
    fi

    errfile="${TRIM_PKGVAR}/pg0-install.log"
    # shellcheck disable=SC1090
    if ! . "${ENSURE_PG0}" >"${errfile}" 2>&1; then
        detail="$(tail -c 1500 "${errfile}" 2>/dev/null | tr '\n' ' ')"
        echo "failed to start local pg0: ${detail}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
        exit 1
    fi
    load_env

    # Persist the runtime env for restarts and upgrades.
    {
        echo "DATABASE_URL=${DATABASE_URL}"
        echo "ROUNDPEN_DATA_ROOT=${ROUNDPEN_DATA_ROOT}"
        echo "ROUNDPEN_HTTP_ADDR=${ROUNDPEN_HTTP_ADDR}"
        echo "ROUNDPEN_BACKEND=${ROUNDPEN_BACKEND}"
        echo "ROUNDPEN_BOOTSTRAP_ADMIN=${ROUNDPEN_BOOTSTRAP_ADMIN}"
        echo "ROUNDPEN_BOOTSTRAP_ADMIN_PASSWORD=${ROUNDPEN_BOOTSTRAP_ADMIN_PASSWORD}"
        echo "ROUNDPEN_IM_ENABLED=${ROUNDPEN_IM_ENABLED}"
        echo "ROUNDPEN_AGENT_IMAGE=${ROUNDPEN_AGENT_IMAGE}"
        echo "ROUNDPEN_DEFAULT_IMAGE=${ROUNDPEN_DEFAULT_IMAGE}"
        echo "ROUNDPEN_PREVIEW_PUBLIC_URL=${ROUNDPEN_PREVIEW_PUBLIC_URL}"
    } > "${ENVFILE}"

    # Roundpend loads .env from cwd; run from the data root and pass env.
    cd "${TRIM_PKGVAR}" || exit 1
    nohup "${ROUNDPEND}" >> "${LOGFILE}" 2>&1 &
    echo $! > "${PIDFILE}"

    # Brief wait so status/checkport see a live listener when possible.
    i=0
    while [ "$i" -lt 40 ]; do
        if curl -sf --max-time 0.4 "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1 \
            || curl -sf --max-time 0.4 "http://127.0.0.1:${PORT}/v1/ready" >/dev/null 2>&1; then
            exit 0
        fi
        if ! is_running; then
            echo "roundpend exited during start; see ${LOGFILE}" > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
            exit 1
        fi
        sleep 0.25
        i=$((i + 1))
    done
    # Process is up even if health is slow; let checkport handle readiness.
    exit 0
}

do_stop() {
    if [ -f "${PIDFILE}" ]; then
        pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            kill "${pid}" 2>/dev/null || true
            # Wait briefly for a clean exit.
            i=0
            while [ "$i" -lt 20 ] && kill -0 "${pid}" 2>/dev/null; do
                sleep 0.25
                i=$((i + 1))
            done
            kill -9 "${pid}" 2>/dev/null || true
        fi
        rm -f "${PIDFILE}"
    fi
    exit 0
}

do_status() {
    if is_running; then
        exit 0
    fi
    exit 3
}

case "${1:-}" in
start)
    do_start
    ;;
stop)
    do_stop
    ;;
status)
    do_status
    ;;
*)
    exit 1
    ;;
esac
